# Server Configuration
# Port where the API will run (default: 3000)
PORT=3000

# DynamoDB Configuration
# DynamoDB endpoint — uses LocalStack (http://localhost:4566) for local development
DYNAMO_ENDPOINT=http://localhost:4566

# AWS Region for DynamoDB
DYNAMO_REGION=us-east-1

# AWS Credentials
# For local development, you can use fake credentials
# For production, use real AWS credentials or IAM roles
AWS_ACCESS_KEY_ID=fakeMyKeyId
AWS_SECRET_ACCESS_KEY=fakeSecretAccessKey

# DynamoDB Table Name
TABLE_NAME=MercadoGlobal

# Cache Configuration
# TTL in seconds for cached data (default: 300 = 5 minutes)
CACHE_TTL_SECONDS=300
# Set to "false" to disable caching entirely (default: true)
CACHE_ENABLED=true
# Redis is the only cache adapter used by the project
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=mercadoglobal
